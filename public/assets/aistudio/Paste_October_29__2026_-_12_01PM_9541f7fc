    async function generateMotionTimeline(customText, apiKey) {
      const dur = videoDuration || 15;

      // Jika user mengisi Gemini API Key, minta Gemini membuatkan naskah overlay kontekstual
      if (apiKey) {
        try {
          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{
                parts: [{
                  text: `Buatkan array JSON murni (tanpa markdown) berisi daftar efek motion graphic untuk video pendek durasi ${Math.round(dur)} detik dengan gaya "${selectedStyle}" dan instruksi "${customText}". Setiap item objek wajib memiliki: "start" (angka detik), "end" (angka detik), "type" (pilih salah satu: "lower_third", "stat_chart", "broll_badge", "caption"), "title" (teks utama singkat maksimal 3 kata), "subtitle" (angka atau sub-teks), "zoom" (boolean). Buat minimal 8 item yang tersebar rata sepanjang durasi.`
                }]
              }]
            })
          });
          const data = await response.json();
          const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
          const jsonMatch = rawText.match(/\[[\s\S]*\]/);
          if (jsonMatch) {
            motionCues = JSON.parse(jsonMatch[0]);
            return;
          }
        } catch (err) {
          console.warn('Fallback ke generator internal:', err);
        }
      }

      // Built-in Smart Motion Generator (100% Gratis Tanpa API)
      const presets = {
        authority: [
          { type: 'lower_third', title: 'STRATEGI INTI', subtitle: 'Authority & Bisnis', zoom: true },
          { type: 'caption', title: 'FOKUS PADA SISTEM', subtitle: '⚡ HIGH IMPACT', zoom: false },
          { type: 'stat_chart', title: 'PERTUMBUHAN', subtitle: '+340% ROI', zoom: true },
          { type: 'broll_badge', title: '💡 INSIGHT UTAMA', subtitle: 'Terbukti Efektif', zoom: false },
          { type: 'caption', title: 'EKSEKUSI SEKARANG', subtitle: '🔥 SIAP POSTING', zoom: true }
        ],
        tech: [
          { type: 'lower_third', title: 'DEMO SISTEM AI', subtitle: 'Auto Motion Engine', zoom: true },
          { type: 'broll_badge', title: '⚙️ OTOMATISASI 100%', subtitle: 'Tanpa Prompt Rumit', zoom: true },
          { type: 'stat_chart', title: 'KECEPATAN RENDER', subtitle: '10x Lebih Cepat', zoom: false },
          { type: 'caption', title: 'LANGSUNG JADI', subtitle: '🚀 PLUG & PLAY', zoom: true }
        ],
        athletic: [
          { type: 'caption', title: 'GO! MULAI SEKARANG', subtitle: '⚡ FULL ENERGY', zoom: true },
          { type: 'broll_badge', title: '🔥 TANPA BATAS', subtitle: 'Maximum Power', zoom: true },
          { type: 'stat_chart', title: 'PERFORMA NAIK', subtitle: '99.9% Fokus', zoom: false },
          { type: 'lower_third', title: 'LEVEL PRO', subtitle: 'Konsistensi Harian', zoom: true }
        ],
        edukasi: [
          { type: 'lower_third', title: 'CATATAN PENTING', subtitle: 'Simpan Video Ini', zoom: false },
          { type: 'broll_badge', title: '📌 POIN #1', subtitle: 'Pahami Fundamental', zoom: true },
          { type: 'caption', title: 'JANGAN LEWATKAN!', subtitle: '✨ TIPS PRAKTIS', zoom: false },
          { type: 'stat_chart', title: 'TINGKAT BERHASIL', subtitle: '87% Lebih Cepat', zoom: true }
        ]
      };

      const baseList = presets[selectedStyle] || presets.authority;
      motionCues = [];
      const segment = dur / (baseList.length + 1);

      baseList.forEach((item, idx) => {
        const start = Number((idx * segment + 0.5).toFixed(1));
        const end = Number(Math.min(dur - 0.2, start + Math.max(2.2, segment * 0.85)).toFixed(1));
        motionCues.push({ ...item, start, end });
      });
    }

    // ================= SOUND EFFECT SYNTHESIZER (WEB AUDIO API) =================
    function playWhooshSfx() {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(190, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(580, audioCtx.currentTime + 0.14);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.16);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.16);
      } catch (e) {}
    }

