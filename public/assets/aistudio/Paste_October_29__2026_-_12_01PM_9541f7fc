<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Auto Motion — AI Video Motion Graphic System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #080b08;
      color: #f3f4f6;
    }
    .neon-bg { background-color: #a3e635; color: #050805; }
    .neon-bg:hover { background-color: #bef264; }
    .neon-border { border-color: #a3e635; }
    .neon-text { color: #a3e635; }
    .card-dark { background-color: #111611; border: 1px solid #1f291f; }
    .step-active { border-color: #a3e635; background-color: #141f14; }
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0d120d; }
    ::-webkit-scrollbar-thumb { background: #263326; border-radius: 3px; }
  </style>
</head>
<body class="min-h-screen pb-16 selection:bg-lime-400 selection:text-black">

  <!-- TOP NAVBAR -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-[#080b08]/90 border-b border-[#1f291f] px-4 py-3">
    <div class="max-w-xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="neon-text text-xl">⚡</span>
        <span class="font-extrabold tracking-tight text-white">Auto Motion</span>
        <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-lime-400/10 neon-text border border-lime-400/30 font-semibold">PRO v2.0</span>
      </div>
      <button onclick="toggleApiModal()" class="text-xs px-3 py-1.5 rounded-lg card-dark hover:border-lime-400/50 flex items-center gap-1.5 transition">
        <span>🔑</span> <span id="apiStatusText">Set AI Key (Opsional)</span>
      </button>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-xl mx-auto px-4 pt-5">
    
    <!-- WINDOW FRAME -->
    <div class="card-dark rounded-2xl p-4 shadow-2xl">
      
      <!-- Mac-style Top Bar -->
      <div class="flex items-center justify-between bg-[#161c16] rounded-xl px-3.5 py-2 mb-4 border border-[#232d23]">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-red-500"></span>
          <span class="w-3 h-3 rounded-full bg-amber-400"></span>
          <span class="w-3 h-3 rounded-full bg-lime-400"></span>
        </div>
        <div class="flex items-center gap-2 text-xs text-gray-300 font-medium">
          <span class="text-gray-500">auto-motion</span>
          <span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
          <span id="windowStatusTitle" class="text-white font-semibold">Upload Footage</span>
        </div>
        <div class="w-8"></div>
      </div>

      <!-- 4 STEP WIZARD HEADER -->
      <div class="grid grid-cols-4 gap-2 mb-6">
        <button onclick="goToStep(1)" id="stepBtn1" class="step-active rounded-xl p-2.5 text-center border transition flex flex-col items-center justify-center">
          <div id="stepCircle1" class="w-6 h-6 rounded-full neon-bg font-bold text-xs flex items-center justify-center mb-1.5">1</div>
          <span class="text-[11px] font-semibold leading-tight text-white">Upload<br>Footage</span>
        </button>
        <button onclick="goToStep(2)" id="stepBtn2" class="card-dark rounded-xl p-2.5 text-center border transition flex flex-col items-center justify-center opacity-60">
          <div id="stepCircle2" class="w-6 h-6 rounded-full bg-[#1e261e] text-gray-400 font-bold text-xs flex items-center justify-center mb-1.5">2</div>
          <span class="text-[11px] font-semibold leading-tight text-gray-300">Pilih<br>Style</span>
        </button>
        <button onclick="goToStep(3)" id="stepBtn3" class="card-dark rounded-xl p-2.5 text-center border transition flex flex-col items-center justify-center opacity-60">
          <div id="stepCircle3" class="w-6 h-6 rounded-full bg-[#1e261e] text-gray-400 font-bold text-xs flex items-center justify-center mb-1.5">3</div>
          <span class="text-[11px] font-semibold leading-tight text-gray-300">Proses<br>Otomatis</span>
        </button>
        <button onclick="goToStep(4)" id="stepBtn4" class="card-dark rounded-xl p-2.5 text-center border transition flex flex-col items-center justify-center opacity-60">
          <div id="stepCircle4" class="w-6 h-6 rounded-full bg-[#1e261e] text-gray-400 font-bold text-xs flex items-center justify-center mb-1.5">4</div>
          <span class="text-[11px] font-semibold leading-tight text-gray-300">Siap<br>Posting</span>
        </button>
      </div>

      <!-- ================= STEP 1: UPLOAD FOOTAGE ================= -->
      <section id="step1Content" class="space-y-4">
        <div class="border-2 border-dashed border-[#2b3b2b] hover:border-lime-400/60 rounded-2xl p-8 text-center transition bg-[#0c100c]">
          <div class="w-12 h-12 rounded-xl bg-[#182218] neon-text flex items-center justify-center mx-auto mb-3 text-2xl font-bold">
            ↑
          </div>
          <h2 class="text-base font-bold text-white mb-1">Masukkan video mentah kamu</h2>
          <p class="text-xs text-gray-400 mb-5">Rekaman dari HP atau kamera, durasi sampai 5 menit (.mp4 / .mov)</p>
          
          <input type="file" id="videoInput" accept="video/*" class="hidden" onchange="handleVideoUpload(event)" />
          <label for="videoInput" class="neon-bg font-bold text-sm px-6 py-2.5 rounded-xl cursor-pointer inline-block shadow-lg shadow-lime-400/20 transition">
            Pilih Video
          </label>
        </div>

        <!-- Preview Uploaded File -->
        <div id="uploadPreviewCard" class="hidden card-dark rounded-xl p-3 flex items-center gap-3">
          <video id="thumbVideo" class="w-14 h-16 object-cover rounded-lg bg-black border border-gray-800" muted playsinline></video>
          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-center mb-1">
              <p id="fileNameDisplay" class="text-sm font-bold text-white truncate">video-mentah.mp4</p>
              <span id="fileDurationDisplay" class="text-[11px] bg-black/60 px-2 py-0.5 rounded text-gray-300">0:00</span>
            </div>
            <p id="uploadStatusLabel" class="text-xs neon-text mb-1.5">100% · Siap diproses</p>
            <div class="w-full h-1.5 bg-gray-800 rounded-full overflow-hidden">
              <div class="h-full neon-bg w-full"></div>
            </div>
          </div>
        </div>

        <button id="toStep2Btn" onclick="goToStep(2)" disabled class="w-full py-3.5 rounded-xl font-bold text-sm neon-bg opacity-40 cursor-not-allowed transition">
          Lanjut Pilih Style →
        </button>
      </section>

      <!-- ================= STEP 2: PILIH STYLE ================= -->
      <section id="step2Content" class="hidden space-y-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-white">Pilih tema style editing</h3>
          <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-amber-400 text-black">15+ STYLE TERSEDIA</span>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <!-- Style 1 -->
          <div onclick="selectStyle('authority', this)" class="style-card step-active cursor-pointer rounded-xl p-3 border transition relative">
            <div class="h-14 rounded-lg bg-[#141d2b] mb-2.5 p-2 flex items-end justify-between overflow-hidden">
              <div class="w-16 h-2.5 bg-white rounded"></div>
              <div class="flex items-end gap-1">
                <div class="w-2 h-4 bg-amber-400 rounded-t"></div>
                <div class="w-2 h-6 bg-amber-400 rounded-t"></div>
                <div class="w-2 h-9 bg-amber-400 rounded-t"></div>
              </div>
            </div>
            <h4 class="font-bold text-xs text-white">Authority & Bisnis</h4>
            <p class="text-[11px] text-gray-400">Lower third + angka</p>
          </div>

          <!-- Style 2 -->
          <div onclick="selectStyle('tech', this)" class="style-card card-dark cursor-pointer rounded-xl p-3 border transition relative">
            <div class="h-14 rounded-lg bg-[#101926] mb-2.5 p-2 flex items-center justify-between">
              <div class="space-y-1.5">
                <div class="w-14 h-1.5 bg-cyan-400 rounded"></div>
                <div class="w-10 h-1.5 bg-lime-400 rounded"></div>
              </div>
              <div class="w-6 h-6 rounded-full border-2 border-amber-300"></div>
            </div>
            <h4 class="font-bold text-xs text-white">Tech & Software Demo</h4>
            <p class="text-[11px] text-gray-400">Zoom layar + callout</p>
          </div>

          <!-- Style 3 -->
          <div onclick="selectStyle('athletic', this)" class="style-card card-dark cursor-pointer rounded-xl p-3 border transition relative">
            <div class="h-14 rounded-lg bg-gradient-to-r from-red-600 to-orange-500 mb-2.5 flex items-center justify-center">
              <span class="font-black italic text-white text-base drop-shadow">GO!</span>
            </div>
            <h4 class="font-bold text-xs text-white">Athletic & High Energy</h4>
            <p class="text-[11px] text-gray-400">Cut cepat + speed</p>
          </div>

          <!-- Style 4 -->
          <div onclick="selectStyle('edukasi', this)" class="style-card card-dark cursor-pointer rounded-xl p-3 border transition relative">
            <div class="h-14 rounded-lg bg-[#101926] mb-2.5 p-2 flex items-center gap-2">
              <div class="w-5 h-5 rounded bg-sky-400"></div>
              <div class="flex-1 h-2.5 bg-amber-400 rounded"></div>
            </div>
            <h4 class="font-bold text-xs text-white">Edukasi & Personal Brand</h4>
            <p class="text-[11px] text-gray-400">Ikon + highlight</p>
          </div>
        </div>

        <!-- Custom Prompt / Topik Video -->
        <div class="pt-1">
          <p class="text-[10px] uppercase tracking-wider text-gray-400 text-center mb-2">ATAU REQUEST STYLE / TOPIK PEMBICARAAN</p>
          <div class="flex items-center bg-[#0d120d] border border-[#263326] rounded-xl px-3 py-2.5">
            <span class="neon-text mr-2 font-bold">+</span>
            <input id="customInstructionInput" type="text" placeholder="Contoh: Bahas omset naik 300%, zoom di kata penting..." class="bg-transparent text-xs text-white w-full focus:outline-none" value="Zoom di kata penting + tampilkan grafik & highlight teks" />
          </div>
        </div>

        <button onclick="startAutomatedProcessing()" class="w-full py-3.5 rounded-xl font-bold text-sm neon-bg shadow-lg shadow-lime-400/20 transition">
          Proses Video →
        </button>
      </section>

      <!-- ================= STEP 3: PROSES OTOMATIS ================= -->
      <section id="step3Content" class="hidden space-y-4">
        <div class="grid grid-cols-3 gap-2.5 text-center">
          <div class="card-dark rounded-xl p-3">
            <div id="countBroll" class="text-2xl font-extrabold text-white">0</div>
            <div class="text-[10px] text-gray-400 uppercase mt-0.5">B-ROLL</div>
          </div>
          <div class="card-dark rounded-xl p-3">
            <div id="countMotion" class="text-2xl font-extrabold text-white">0</div>
            <div class="text-[10px] text-gray-400 uppercase mt-0.5">MOTION</div>
          </div>
          <div class="card-dark rounded-xl p-3">
            <div id="countText" class="text-2xl font-extrabold text-white">0</div>
            <div class="text-[10px] text-gray-400 uppercase mt-0.5">EFEK TEKS</div>
          </div>
        </div>

        <!-- Visual Timeline Box -->
        <div class="card-dark rounded-xl p-3 space-y-2.5 relative overflow-hidden">
          <div class="flex justify-between items-center text-[11px]">
            <span class="flex items-center gap-1.5 font-bold text-gray-200">
              <span class="w-2 h-2 rounded-full bg-lime-400"></span> TIMELINE OTOMATIS
            </span>
            <span id="timelineTimecode" class="text-gray-400 font-mono">00:00:00 / 00:18:00</span>
          </div>

          <div class="relative bg-[#0b0e0b] rounded-lg p-3 border border-[#1d261d] space-y-2">
            <!-- Playhead Line -->
            <div id="timelinePlayhead" class="absolute top-0 bottom-0 left-1/4 w-0.5 bg-white z-10 transition-all duration-300"></div>

            <!-- Layer 1: B-Roll & Motion -->
            <div class="flex gap-2 items-center h-6">
              <span class="text-[10px] text-gray-500 w-10">FX</span>
              <div class="flex-1 flex gap-2 relative">
                <span class="px-2 py-0.5 rounded bg-gradient-to-r from-orange-500 to-amber-500 text-[10px] font-bold text-black">B-Roll 1</span>
                <span class="px-2 py-0.5 rounded bg-sky-500 text-[10px] font-bold text-black">Motion Chart</span>
                <span class="px-2 py-0.5 rounded bg-lime-400 text-[10px] font-bold text-black">Lower Third</span>
              </div>
            </div>

            <!-- Layer 2: Main Video Strip -->
            <div class="flex gap-2 items-center h-8">
              <span class="text-[9px] bg-white text-black font-bold px-1.5 py-0.5 rounded">Cover</span>
              <div class="flex-1 h-7 rounded bg-gradient-to-r from-stone-800 via-stone-700 to-stone-800 flex items-center px-2 text-[10px] text-gray-300 border border-stone-600">
                Video Utama (Talking Head)
              </div>
            </div>
          </div>
        </div>

        <!-- Progress Bar Status -->
        <div class="card-dark rounded-xl p-3">
          <div class="flex justify-between text-xs mb-2">
            <span id="processStepLabel" class="text-gray-200 font-medium">Menganalisis ucapan & menyisipkan B-Roll...</span>
            <span id="processPercentLabel" class="font-bold neon-text">0%</span>
          </div>
          <div class="w-full h-2 bg-gray-800 rounded-full overflow-hidden">
            <div id="processProgressBar" class="h-full neon-bg w-0 transition-all duration-300"></div>
          </div>
        </div>
      </section>

      <!-- ================= STEP 4: SIAP POSTING (RENDER & EXPORT) ================= -->
      <section id="step4Content" class="hidden space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
          
          <!-- Left: 9:16 Vertical Canvas Video Player -->
          <div class="md:col-span-6 relative mx-auto w-full max-w-[240px]">
            <div class="relative rounded-2xl overflow-hidden border-2 border-[#2a382a] bg-black aspect-[9/16] shadow-xl">
              <canvas id="renderCanvas" width="540" height="960" class="w-full h-full object-cover"></canvas>
              
              <!-- Play/Sound Button Overlay -->
              <button onclick="togglePreviewPlay()" id="playPauseOverlayBtn" class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-black/75 hover:bg-black text-white text-xs font-semibold px-3.5 py-1.5 rounded-full border border-white/20 flex items-center gap-1.5 backdrop-blur-md transition">
                <span>🔊</span> <span id="playBtnText">Putar dengan suara</span>
              </button>
            </div>
          </div>

          <!-- Right: Metadata, Actions & Live Editor -->
          <div class="md:col-span-6 space-y-3">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-xs font-semibold">
              <span>✓</span> Video selesai diproses
            </div>

            <div>
              <h3 class="text-lg font-extrabold text-white">video-final.mp4</h3>
              <p id="finalSpecText" class="text-xs text-gray-400">Format 9:16 · Siap upload</p>
            </div>

            <!-- Summary Badges -->
            <div class="flex flex-wrap gap-1.5">
              <span id="badgeBroll" class="text-[11px] px-2.5 py-1 rounded-full card-dark text-gray-200">4 B-Roll</span>
              <span id="badgeMotion" class="text-[11px] px-2.5 py-1 rounded-full card-dark text-gray-200">6 Motion</span>
              <span id="badgeText" class="text-[11px] px-2.5 py-1 rounded-full card-dark text-gray-200">8 Efek Teks</span>
              <span class="text-[11px] px-2.5 py-1 rounded-full card-dark neon-text">✓ Sound FX</span>
            </div>

            <!-- Export & Download Button -->
            <button id="exportBtn" onclick="exportFinalVideo()" class="w-full py-3 rounded-xl font-bold text-sm neon-bg flex items-center justify-center gap-2 shadow-lg shadow-lime-400/20 transition">
              <span>↓</span> <span id="exportBtnLabel">Unduh Video (.webm/.mp4)</span>
            </button>

            <div class="flex gap-1.5">
              <span class="text-[10px] px-2.5 py-1 rounded-md bg-[#141914] text-gray-400 border border-[#222b22]">TikTok</span>
              <span class="text-[10px] px-2.5 py-1 rounded-md bg-[#141914] text-gray-400 border border-[#222b22]">Reels</span>
              <span class="text-[10px] px-2.5 py-1 rounded-md bg-[#141914] text-gray-400 border border-[#222b22]">Shorts</span>
            </div>

            <!-- Optional In-Tool Editor -->
            <div class="border border-dashed border-[#2d3d2d] rounded-xl p-3 bg-[#0c110c] space-y-2">
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-lime-400/10 neon-text border border-lime-400/30">OPSIONAL</span>
              <p class="text-xs text-gray-300">Masih ada yang mau ditambah? Bisa langsung diedit di dalam tools.</p>
              <button onclick="toggleCueEditor()" class="w-full py-1.5 rounded-lg text-xs font-semibold bg-[#182218] hover:bg-[#223022] neon-text border border-lime-400/30 transition">
                ✏️ Buka Editor Teks & Motion
              </button>
            </div>
          </div>
        </div>

        <!-- COLLAPSIBLE CUE EDITOR -->
        <div id="cueEditorPanel" class="hidden card-dark rounded-xl p-3.5 space-y-3 border border-lime-400/40">
          <div class="flex justify-between items-center">
            <h4 class="text-xs font-bold neon-text uppercase tracking-wider">Editor Layer Motion Graphic & Caption</h4>
            <button onclick="addNewCueItem()" class="text-xs px-2.5 py-1 rounded neon-bg font-bold">+ Tambah Efek</button>
          </div>
          <div id="cueListContainer" class="space-y-2 max-h-56 overflow-y-auto pr-1"></div>
        </div>
      </section>

    </div>
  </main>

  <!-- MODAL: GEMINI API KEY (BYOK UNTUK KOMERSIAL) -->
  <div id="apiModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="card-dark rounded-2xl max-w-md w-full p-5 space-y-4 border border-lime-400/40">
      <div class="flex justify-between items-center">
        <h3 class="font-bold text-white text-base">🔑 Konfigurasi Gemini AI (Gratis)</h3>
        <button onclick="toggleApiModal()" class="text-gray-400 hover:text-white">✕</button>
      </div>
      <p class="text-xs text-gray-300 leading-relaxed">
        Aplikasi ini sudah memiliki <b>Auto-Smart Motion Generator</b> bawaan tanpa API. Namun jika Anda memasukkan <b>Gemini API Key</b> gratis dari Google AI Studio, AI akan mendengarkan isi pembicaraan video dan membuatkan teks serta grafik yang 100% sesuai konteks kalimat.
      </p>
      <input id="geminiApiKeyInput" type="password" placeholder="Tempelkan API Key (AIzaSy...)" class="w-full bg-[#0b0f0b] border border-[#283828] rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-lime-400" />
      <div class="flex justify-end gap-2">
        <button onclick="saveApiKey()" class="neon-bg text-xs font-bold px-4 py-2 rounded-xl">Simpan Key</button>
      </div>
    </div>
  </div>

  <!-- HIDDEN SOURCE VIDEO FOR CANVAS RENDERING -->
  <video id="sourceVideo" class="hidden" playsinline crossorigin="anonymous"></video>

  <script>
    // ================= STATE MANAGEMENT =================
    let selectedStyle = 'authority';
    let videoDuration = 18;
    let animationFrameId = null;
    let audioCtx = null;
    let lastTriggeredCueIndex = -1;

    // Daftar Cue (Jadwal munculnya Motion Graphic di atas video)
    let motionCues = [];

    const sourceVideo = document.getElementById('sourceVideo');
    const thumbVideo = document.getElementById('thumbVideo');
    const canvas = document.getElementById('renderCanvas');
    const ctx = canvas.getContext('2d');

    // Load saved API Key
    window.addEventListener('DOMContentLoaded', () => {
      const savedKey = localStorage.getItem('automotion_gemini_key');
      if (savedKey) {
        document.getElementById('geminiApiKeyInput').value = savedKey;
        document.getElementById('apiStatusText').textContent = 'AI Key Aktif ✓';
      }
    });

    function toggleApiModal() {
      document.getElementById('apiModal').classList.toggle('hidden');
    }

    function saveApiKey() {
      const val = document.getElementById('geminiApiKeyInput').value.trim();
      if (val) {
        localStorage.setItem('automotion_gemini_key', val);
        document.getElementById('apiStatusText').textContent = 'AI Key Aktif ✓';
      } else {
        localStorage.removeItem('automotion_gemini_key');
        document.getElementById('apiStatusText').textContent = 'Set AI Key (Opsional)';
      }
      toggleApiModal();
    }

    // ================= WIZARD NAVIGATION =================
    function goToStep(step) {
      if (step > 1 && !sourceVideo.src) {
        alert('Silakan pilih video mentah terlebih dahulu di Langkah 1.');
        return;
      }
      const titles = ['Upload Footage', 'Pilih Style', 'Proses Otomatis', 'Siap Posting'];
      document.getElementById('windowStatusTitle').textContent = titles[step - 1];

      for (let i = 1; i <= 4; i++) {
        const content = document.getElementById(`step${i}Content`);
        const btn = document.getElementById(`stepBtn${i}`);
        const circle = document.getElementById(`stepCircle${i}`);

        if (i === step) {
          content.classList.remove('hidden');
          btn.className = 'step-active rounded-xl p-2.5 text-center border transition flex flex-col items-center justify-center';
          circle.className = 'w-6 h-6 rounded-full neon-bg font-bold text-xs flex items-center justify-center mb-1.5';
        } else {
          content.classList.add('hidden');
          btn.className = 'card-dark rounded-xl p-2.5 text-center border transition flex flex-col items-center justify-center opacity-70';
          circle.className = 'w-6 h-6 rounded-full bg-[#1e261e] text-gray-400 font-bold text-xs flex items-center justify-center mb-1.5';
        }
      }

      if (step === 4) {
        startCanvasRenderLoop();
      }
    }

    // ================= STEP 1: HANDLE VIDEO UPLOAD =================
    function handleVideoUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const url = URL.createObjectURL(file);
      sourceVideo.src = url;
      thumbVideo.src = url;

      document.getElementById('fileNameDisplay').textContent = file.name;
      document.getElementById('uploadPreviewCard').classList.remove('hidden');

      sourceVideo.onloadedmetadata = () => {
        videoDuration = Math.max(4, Math.min(sourceVideo.duration || 18, 300));
        const mins = Math.floor(videoDuration / 60);
        const secs = Math.floor(videoDuration % 60).toString().padStart(2, '0');
        document.getElementById('fileDurationDisplay').textContent = `${mins}:${secs}`;
        document.getElementById('finalSpecText').textContent = `Format 9:16 · ${mins}:${secs} · siap upload`;

        const btn = document.getElementById('toStep2Btn');
        btn.disabled = false;
        btn.classList.remove('opacity-40', 'cursor-not-allowed');
      };
    }

    // ================= STEP 2: SELECT STYLE =================
    function selectStyle(styleKey, el) {
      selectedStyle = styleKey;
      document.querySelectorAll('.style-card').forEach(card => {
