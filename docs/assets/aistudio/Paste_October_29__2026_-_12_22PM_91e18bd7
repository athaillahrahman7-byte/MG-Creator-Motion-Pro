<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Auto Motion AI — Smart Content Video Editor</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #080b08; color: #ffffff; font-family: 'Inter', sans-serif; }
    .neon-bg { background-color: #a3e635; color: #080b08; }
    .neon-border { border-color: #a3e635; }
    .card-bg { background-color: #121612; border: 1px solid #222922; }
    .step-active { border-color: #a3e635; background-color: #162013; }
  </style>
</head>
<body class="min-h-screen p-4 md:p-8 flex flex-col items-center">

  <div class="w-full max-w-3xl card-bg rounded-2xl p-5 shadow-2xl">
    
    <!-- Top Bar & API Key Input -->
    <div class="flex flex-wrap items-center justify-between border-b border-neutral-800 pb-4 mb-5 gap-3">
      <div class="flex items-center gap-2">
        <span class="text-lime-400 text-xl font-bold">⚡ Auto Motion AI</span>
        <span class="text-xs bg-lime-950 text-lime-400 px-2.5 py-0.5 rounded-full border border-lime-800">v2.0 Smart Sync</span>
      </div>
      
      <div class="flex items-center gap-2">
        <input id="gemini-api-key" type="password" placeholder="Masukkan Gemini API Key..." 
          class="bg-neutral-900 border border-neutral-700 rounded-lg px-3 py-1.5 text-xs text-white focus:border-lime-400 focus:outline-none w-48"
          onchange="saveApiKey()">
        <a href="https://aistudio.google.com/app/apikey" target="_blank" class="text-[11px] bg-neutral-800 hover:bg-neutral-700 text-lime-400 px-2.5 py-1.5 rounded-lg border border-neutral-700">
          Ambil Key Gratis ↗
        </a>
      </div>
    </div>

    <!-- Navigasi 4 Langkah -->
    <div class="grid grid-cols-4 gap-2 mb-6 text-center text-xs">
      <div id="nav-1" class="p-3 rounded-xl border step-active transition">
        <div class="w-6 h-6 mx-auto mb-1 rounded-full neon-bg font-bold flex items-center justify-center">1</div>
        <span class="font-medium">Upload Footage</span>
      </div>
      <div id="nav-2" class="p-3 rounded-xl border border-neutral-800 bg-neutral-900/50 text-neutral-400 transition">
        <div class="w-6 h-6 mx-auto mb-1 rounded-full bg-neutral-800 font-bold flex items-center justify-center">2</div>
        <span class="font-medium">Pilih Style</span>
      </div>
      <div id="nav-3" class="p-3 rounded-xl border border-neutral-800 bg-neutral-900/50 text-neutral-400 transition">
        <div class="w-6 h-6 mx-auto mb-1 rounded-full bg-neutral-800 font-bold flex items-center justify-center">3</div>
        <span class="font-medium">AI Analisis</span>
      </div>
      <div id="nav-4" class="p-3 rounded-xl border border-neutral-800 bg-neutral-900/50 text-neutral-400 transition">
        <div class="w-6 h-6 mx-auto mb-1 rounded-full bg-neutral-800 font-bold flex items-center justify-center">4</div>
        <span class="font-medium">Siap Posting</span>
      </div>
    </div>

    <!-- STEP 1: UPLOAD FOOTAGE -->
    <div id="step-1" class="space-y-4">
      <div class="border-2 border-dashed border-neutral-700 rounded-2xl p-8 text-center hover:border-lime-400 transition">
        <div class="w-12 h-12 rounded-xl bg-lime-950/60 border border-lime-700 text-lime-400 flex items-center justify-center mx-auto mb-3 text-xl">↑</div>
        <h3 class="font-bold text-lg mb-1">Masukkan video mentah kamu</h3>
        <p class="text-xs text-neutral-400 mb-5">AI akan mendengarkan suara & melihat isi video untuk membuat Motion Graphic yang relevan</p>
        <label class="neon-bg font-bold px-6 py-2.5 rounded-xl cursor-pointer inline-block hover:opacity-90 transition">
          Pilih Video
          <input type="file" id="video-upload" accept="video/*" class="hidden">
        </label>
      </div>

      <div id="upload-preview" class="hidden card-bg p-4 rounded-xl flex items-center justify-between">
        <div>
          <p id="file-name" class="font-semibold text-sm text-white">video-mentah.mp4</p>
          <p id="file-duration" class="text-xs text-lime-400">Siap dianalisis oleh AI</p>
        </div>
        <button onclick="goToStep(2)" class="neon-bg px-4 py-2 rounded-lg text-xs font-bold">Lanjut Pilih Style →</button>
      </div>
    </div>

    <!-- STEP 2: PILIH STYLE (DENGAN MODE AI AUTO-DETECT) -->
    <div id="step-2" class="hidden space-y-4">
      
      <!-- Opsi AI Otomatis Memilih Style -->
      <div onclick="selectStyle('auto', this)" class="style-card p-4 rounded-xl border-2 neon-border bg-lime-950/20 cursor-pointer flex items-center justify-between">
        <div>
          <span class="text-[10px] neon-bg font-extrabold px-2 py-0.5 rounded uppercase">Rekomendasi Cerdas</span>
          <p class="font-bold text-base mt-1 text-lime-300">🤖 Biarkan AI Memilih Style & Motion Sesuai Isi Video</p>
          <p class="text-xs text-neutral-400">AI akan mendengarkan materi pembicaraan dan menyesuaikan grafik, ikon, & teks di detik yang tepat.</p>
        </div>
        <div class="text-2xl">✨</div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div onclick="selectStyle('authority', this)" class="style-card p-3.5 rounded-xl border border-neutral-800 bg-neutral-900 cursor-pointer">
          <p class="font-bold text-sm">📊 Authority & Bisnis</p>
          <p class="text-xs text-neutral-400">Lower third + grafik data/angka</p>
        </div>
        <div onclick="selectStyle('tech', this)" class="style-card p-3.5 rounded-xl border border-neutral-800 bg-neutral-900 cursor-pointer">
          <p class="font-bold text-sm">💻 Tech & Software Demo</p>
          <p class="text-xs text-neutral-400">Zoom layar + callout box</p>
        </div>
        <div onclick="selectStyle('energy', this)" class="style-card p-3.5 rounded-xl border border-neutral-800 bg-neutral-900 cursor-pointer">
          <p class="font-bold text-sm">🔥 Athletic & High Energy</p>
          <p class="text-xs text-neutral-400">Cut cepat + pop-up teks besar</p>
        </div>
        <div onclick="selectStyle('edukasi', this)" class="style-card p-3.5 rounded-xl border border-neutral-800 bg-neutral-900 cursor-pointer">
          <p class="font-bold text-sm">💡 Edukasi & Personal Brand</p>
          <p class="text-xs text-neutral-400">Kartu B-Roll + ikon & highlight</p>
        </div>
      </div>

      <div>
        <label class="text-xs text-neutral-400 block mb-1">Instruksi Tambahan ke AI (Opsional):</label>
        <input id="custom-prompt" type="text" placeholder="Contoh: Fokuskan grafik saat saya membahas persentase keuntungan..." 
          class="w-full bg-neutral-900 border border-neutral-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-lime-400">
      </div>

      <button onclick="analyzeVideoWithAI()" class="w-full neon-bg font-bold py-3 rounded-xl text-sm hover:opacity-95 transition">
        Analisis Isi Video & Buat Motion Graphic →
      </button>
    </div>

    <!-- STEP 3: PROSES ANALISIS AI -->
    <div id="step-3" class="hidden space-y-4">
      <div class="grid grid-cols-3 gap-3 text-center">
        <div class="card-bg p-3 rounded-xl"><p id="count-broll" class="text-2xl font-bold text-lime-400">0</p><p class="text-xs text-neutral-400">B-ROLL RELEVAN</p></div>
        <div class="card-bg p-3 rounded-xl"><p id="count-motion" class="text-2xl font-bold text-amber-400">0</p><p class="text-xs text-neutral-400">MOTION GRAFIK</p></div>
        <div class="card-bg p-3 rounded-xl"><p id="count-text" class="text-2xl font-bold text-sky-400">0</p><p class="text-xs text-neutral-400">CAPTION TIMED</p></div>
      </div>

      <div class="card-bg p-5 rounded-xl space-y-3 text-center">
        <div class="animate-spin w-8 h-8 border-4 border-lime-400 border-t-transparent rounded-full mx-auto"></div>
        <p id="ai-status-text" class="text-sm font-semibold text-lime-300">Mengekstrak audio & visual dari video...</p>
        <p class="text-xs text-neutral-400">AI sedang mencocokkan detik ucapan dengan grafik, ikon, dan efek teks yang sesuai.</p>
      </div>
    </div>

    <!-- STEP 4: SIAP POSTING & TIMELINE EDITOR -->
    <div id="step-4" class="hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-start">
        
        <!-- Preview Video Canvas 9:16 (5 Kolom) -->
        <div class="md:col-span-5 flex flex-col items-center">
          <div class="relative w-full max-w-[260px] aspect-[9/16] bg-black rounded-2xl overflow-hidden border border-neutral-700 shadow-lg">
            <canvas id="render-canvas" width="540" height="960" class="w-full h-full object-cover"></canvas>
            <button onclick="togglePlay()" id="play-btn" class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-black/85 border border-lime-500 text-white text-xs px-4 py-1.5 rounded-full hover:bg-neutral-800 font-semibold whitespace-nowrap">
              ▶ Putar Hasil Editan
            </button>
          </div>
        </div>

        <!-- Panel Kanan: Hasil Analisis AI & Live Cue Editor (7 Kolom) -->
        <div class="md:col-span-7 space-y-3">
          <div class="flex items-center justify-between">
            <span id="detected-style-badge" class="bg-lime-950 border border-lime-700 text-lime-300 text-xs px-3 py-1 rounded-full font-semibold">
              ✓ Style Terpilih: Auto
            </span>
            <button onclick="goToStep(2)" class="text-xs text-neutral-400 hover:text-white underline">Analisis Ulang</button>
          </div>

          <!-- Editor Nama Pembicara / Lower Third -->
          <div class="card-bg p-3 rounded-xl grid grid-cols-2 gap-2">
            <div>
              <label class="text-[10px] text-neutral-400">JUDUL LOWER THIRD (DETECTED)</label>
              <input id="speaker-name" type="text" value="Materi Utama" oninput="drawCanvasFrame()" class="w-full bg-neutral-900 border border-neutral-700 rounded px-2.5 py-1 text-xs text-white mt-0.5">
            </div>
            <div>
              <label class="text-[10px] text-neutral-400">SUB-JUDUL TOPIK</label>
              <input id="speaker-role" type="text" value="Poin Penting Video" oninput="drawCanvasFrame()" class="w-full bg-neutral-900 border border-neutral-700 rounded px-2.5 py-1 text-xs text-white mt-0.5">
            </div>
          </div>

          <!-- Daftar Cue Motion Graphic sesuai Detik Isi Video -->
          <div class="card-bg p-3 rounded-xl">
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-bold text-lime-400">📋 TIMELINE MOTION GRAPHIC (SESUAI ISI VIDEO)</span>
              <button onclick="addNewCue()" class="text-[11px] bg-neutral-800 hover:bg-neutral-700 px-2 py-0.5 rounded border border-neutral-600">+ Tambah Efek</button>
            </div>
            <div id="cue-list" class="space-y-2 max-h-56 overflow-y-auto pr-1 text-xs">
              <!-- Diisi otomatis oleh AI berdasarkan isi video -->
            </div>
          </div>

          <button id="download-btn" onclick="exportFinalVideo()" class="w-full neon-bg font-bold py-3 rounded-xl text-sm flex items-center justify-center gap-2 hover:opacity-90 transition">
            ↓ Unduh Video Hasil Render (.webm)
          </button>
        </div>

      </div>
    </div>

  </div>

  <video id="source-video" class="hidden" playsinline crossorigin="anonymous"></video>

  <script>
    const video = document.getElementById('source-video');
    const canvas = document.getElementById('render-canvas');
    const ctx = canvas.getContext('2d');
    let uploadedFile = null;
    let selectedStyle = 'auto';

    // Struktur Timeline Events hasil analisis isi video
    let timelineCues = [];

    // Load API Key dari LocalStorage jika pernah diisi
    window.onload = () => {
      const savedKey = localStorage.getItem('automotion_gemini_key');
      if (savedKey) document.getElementById('gemini-api-key').value = savedKey;
    };

    function saveApiKey() {
      const key = document.getElementById('gemini-api-key').value.trim();
      localStorage.setItem('automotion_gemini_key', key);
    }

    // 1. Upload Video
    document.getElementById('video-upload').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      uploadedFile = file;
      video.src = URL.createObjectURL(file);
      document.getElementById('file-name').innerText = file.name;
      document.getElementById('upload-preview').classList.remove('hidden');
      video.onloadedmetadata = () => {
        document.getElementById('file-duration').innerText = `Durasi: ${Math.round(video.duration)} detik • Ukuran: ${(file.size / 1024 / 1024).toFixed(1)} MB`;
      };
    });

    function goToStep(step) {
      for (let i = 1; i <= 4; i++) {
        document.getElementById(`step-${i}`).classList.toggle('hidden', i !== step);
        const nav = document.getElementById(`nav-${i}`);
        if (i <= step) nav.classList.add('step-active');
      }
    }

    function selectStyle(style, el) {
      selectedStyle = style;
      document.querySelectorAll('.style-card').forEach(c => {
        c.classList.remove('neon-border', 'border-2');
        c.classList.add('border', 'border-neutral-800');
      });
      el.classList.add('neon-border', 'border-2');
    }

    // Helper: Ubah file video menjadi Base64 untuk dikirim ke Gemini API
    function fileToGenerativePart(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => {
          const base64Data = reader.result.split(',')[1];
          resolve({ inlineData: { data: base64Data, mimeType: file.type || 'video/mp4' } });
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    // 3. Fungsi Inti: Analisis Isi Materi Video Menggunakan Gemini 2.5 Flash
    async function analyzeVideoWithAI() {
      const apiKey = document.getElementById('gemini-api-key').value.trim();
      const customPrompt = document.getElementById('custom-prompt').value.trim();
      goToStep(3);

      if (!apiKey) {
        alert("Agar AI bisa mendengarkan dan membaca isi materi video Anda secara akurat, silakan masukkan Gemini API Key gratis terlebih dahulu di pojok kanan atas.");
        goToStep(2);
        return;
      }

      try {
        document.getElementById('ai-status-text').innerText = "Mengunggah & membaca materi video dengan Gemini AI...";
        const videoPart = await fileToGenerativePart(uploadedFile);

        document.getElementById('ai-status-text').innerText = "Menganalisis transkrip ucapan, memilih style, dan menyusun timestamp motion graphic...";

        const promptText = `
Anda adalah AI Motion Graphic Video Director profesional. Tonton dan dengarkan isi materi video ini dengan teliti (durasi total sekitar ${Math.round(video.duration)} detik).
Pilihan style dari user: "${selectedStyle}" (Jika 'auto', tentukan style terbaik antara: 'authority', 'tech', 'energy', atau 'edukasi' berdasarkan topik video).
Instruksi tambahan user: "${customPrompt || 'Tidak ada'}".

Tugas Anda:
Buat timeline motion graphic yang 100% NYAMBUNG dan RELEVAN dengan kalimat yang diucapkan pembicara di setiap detiknya.
Kembalikan HANYA format JSON murni dengan struktur berikut:
{
  "detectedStyle": "authority | tech | energy | edukasi",
  "topicTitle": "Judul Singkat Materi Video (Maks 3 kata)",
  "topicSubtitle": "Sub-judul konteks materi (Maks 5 kata)",
  "cues": [
    {
      "start": 0.5,
      "end": 3.5,
      "type": "zoom_caption | stat_chart | broll_card | callout_box",
      "icon": "Emoji yang sangat relevan dengan kalimat di detik ini (contoh: 📈, 💡, 🚀, ⚠️, 💰)",
      "caption": "KATA KUNCI UCAPAN (Maks 4 kata dari ucapan pembicara di detik ini)",
      "brollTitle": "Judul kartu B-Roll / Grafik yang mendukung ucapan",
      "statValue": "Angka/Persentase jika membahas data, atau poin singkat (contoh: +300%, POIN 1, FAKTA)"
    }
  ]
}
Pastikan setiap potongan detik dari awal hingga akhir video memiliki minimal 1 cue setiap 2-4 detik yang benar-benar sesuai dengan ucapan di detik tersebut.`;

        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            contents: [{ parts: [videoPart, { text: promptText }] }],
            generationConfig: { responseMimeType: "application/json" }
          })
        });

        const data = await response.json();
        if (data.error) throw new Error(data.error.message);

        const rawJson = data.candidates[0].content.parts[0].text;
        const result = JSON.parse(rawJson);

        // Terapkan hasil analisis AI ke aplikasi
        selectedStyle = result.detectedStyle || 'edukasi';
        document.getElementById('detected-style-badge').innerText = `✓ AI Style: ${selectedStyle.toUpperCase()}`;
        document.getElementById('speaker-name').value = result.topicTitle || 'Materi Utama';
        document.getElementById('speaker-role').value = result.topicSubtitle || 'Ringkasan Poin Penting';
        timelineCues = result.cues || [];

        document.getElementById('count-broll').innerText = timelineCues.filter(c => c.type === 'broll_card' || c.type === 'stat_chart').length;
        document.getElementById('count-motion').innerText = timelineCues.length;
        document.getElementById('count-text').innerText = timelineCues.length;

        renderCueEditorList();
        goToStep(4);
        video.currentTime = 0;
        requestAnimationFrame(renderLoop);

      } catch (err) {
        alert("Terjadi kendala saat menganalisis video: " + err.message + "\n\nTips: Pastikan ukuran video di bawah 20MB dan API Key Anda aktif.");
        goToStep(2);
      }
    }

    // Tampilkan daftar Motion Graphic yang dibuat AI agar bisa diedit user
    function renderCueEditorList() {
      const container = document.getElementById('cue-list');
      container.innerHTML = '';
      timelineCues.forEach((cue, i) => {
        const div = document.createElement('div');
        div.className = 'p-2.5 rounded-lg bg-neutral-900 border border-neutral-800 flex flex-col gap-1.5';
        div.innerHTML = `
          <div class="flex items-center justify-between gap-2">
            <span class="text-lime-400 font-bold">${cue.start}s - ${cue.end}s</span>
            <select onchange="timelineCues[${i}].type=this.value; drawCanvasFrame()" class="bg-neutral-950 border border-neutral-700 rounded px-2 py-0.5 text-[11px]">
              <option value="broll_card" ${cue.type==='broll_card'?'selected':''}>Kartu B-Roll + Ikon</option>
              <option value="stat_chart" ${cue.type==='stat_chart'?'selected':''}>Grafik Data + Angka</option>
              <option value="callout_box" ${cue.type==='callout_box'?'selected':''}>Tech Callout + Zoom</option>
              <option value="zoom_caption" ${cue.type==='zoom_caption'?'selected':''}>Zoom + Teks Besar</option>
            </select>
            <button onclick="timelineCues.splice(${i},1); renderCueEditorList()" class="text-red-400 hover:text-red-300">✕</button>
          </div>
          <div class="grid grid-cols-6 gap-1.5">
            <input type="text" value="${cue.icon || '💡'}" oninput="timelineCues[${i}].icon=this.value" class="col-span-1 bg-neutral-950 border border-neutral-800 rounded px-1.5 py-1 text-center" title="Emoji/Ikon">
            <input type="text" value="${cue.brollTitle || ''}" placeholder="Judul B-Roll" oninput="timelineCues[${i}].brollTitle=this.value" class="col-span-3 bg-neutral-950 border border-neutral-800 rounded px-2 py-1">
            <input type="text" value="${cue.statValue || ''}" placeholder="Angka/Poin" oninput="timelineCues[${i}].statValue=this.value" class="col-span-2 bg-neutral-950 border border-neutral-800 rounded px-2 py-1 text-amber-300 font-bold">
          </div>
          <input type="text" value="${cue.caption || ''}" placeholder="Teks Caption Ucapan" oninput="timelineCues[${i}].caption=this.value" class="w-full bg-neutral-950 border border-neutral-800 rounded px-2 py-1 text-lime-300 font-semibold">
        `;
        container.appendChild(div);
      });
    }

    function addNewCue() {
      const t = Math.round(video.currentTime || 0);
      timelineCues.push({
        start: t, end: t + 3, type: 'broll_card', icon: '🚀',
        brollTitle: 'Poin Tambahan', statValue: 'PENTING', caption: 'TEKS HIGHLIGHT BARU'
      });
      renderCueEditorList();
    }

    function togglePlay() {
      if (video.paused) {
        video.play();
        document.getElementById('play-btn').innerText = '⏸ Jeda Video';
      } else {
        video.pause();
        document.getElementById('play-btn').innerText = '▶ Putar Hasil Editan';
      }
    }

    // 4. Mesin Render Canvas Kontekstual Sesuai Materi Video
    function drawCanvasFrame() {
      const t = video.currentTime || 0;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Cari cue aktif pada detik berjalan
      const activeCue = timelineCues.find(c => t >= c.start && t <= c.end);

      // Zoom otomatis jika cue bertipe zoom_caption atau callout_box
      const shouldZoom = activeCue && (activeCue.type === 'zoom_caption' || activeCue.type === 'callout_box');
      const scale = shouldZoom ? 1.15 : 1.0;

      ctx.save();
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.scale(scale, scale);
      ctx.translate(-canvas.width / 2, -canvas.height / 2);

      if (video.readyState >= 2) {
        const vw = video.videoWidth, vh = video.videoHeight;
        const targetRatio = canvas.width / canvas.height;
        const videoRatio = vw / vh;
        let sx = 0, sy = 0, sw = vw, sh = vh;
        if (videoRatio > targetRatio) { sw = vh * targetRatio; sx = (vw - sw) / 2; }
        else { sh = vw / targetRatio; sy = (vh - sh) / 2; }
        ctx.drawImage(video, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);
      }
      ctx.restore();

      // Render Lower Third Kontekstual (Muncul di 4 detik pertama video)
      if (t <= 4.5) {
        const title = document.getElementById('speaker-name').value;
        const sub = document.getElementById('speaker-role').value;
        ctx.fillStyle = 'rgba(10, 15, 10, 0.9)';
        ctx.beginPath(); ctx.roundRect(28, 690, 390, 80, 14); ctx.fill();
        ctx.fillStyle = '#a3e635'; ctx.fillRect(28, 690, 8, 80);
        ctx.fillStyle = '#ffffff'; ctx.font = 'bold 21px sans-serif'; ctx.fillText(title, 50, 725);
        ctx.fillStyle = '#a3e635'; ctx.font = '15px sans-serif'; ctx.fillText(sub, 50, 752);
      }

      // Render Motion Graphic Sesuai Cue Materi yang Aktif
      if (activeCue) {
        // A. TIPE GRAFIK DATA & STATISTIK (Authority / Bisnis)
        if (activeCue.type === 'stat_chart') {
          ctx.fillStyle = 'rgba(12, 18, 28, 0.92)';
          ctx.strokeStyle = '#a3e635'; ctx.lineWidth = 2.5;
          ctx.beginPath(); ctx.roundRect(35, 70, 470, 135, 18); ctx.fill(); ctx.stroke();

          ctx.font = '44px sans-serif';
          ctx.fillText(activeCue.icon || '📊', 55, 145);

          ctx.fillStyle = '#94a3b8'; ctx.font = 'bold 14px sans-serif';
          ctx.fillText((activeCue.brollTitle || 'DATA INSIGHT').toUpperCase(), 120, 105);

          ctx.fillStyle = '#a3e635'; ctx.font = '900 34px sans-serif';
          ctx.fillText(activeCue.statValue || '+100%', 120, 148);

          // Mini Bar Chart di kanan kartu
          const bars = [30, 50, 70, 100];
          bars.forEach((h, idx) => {
            ctx.fillStyle = idx === 3 ? '#a3e635' : '#38bdf8';
            const bh = (h / 100) * 75;
            ctx.fillRect(365 + idx * 28, 175 - bh, 18, bh);
          });
        }

        // B. TIPE B-ROLL FLOATING CARD (Edukasi / Personal Brand)
        else if (activeCue.type === 'broll_card') {
          ctx.fillStyle = 'rgba(15, 20, 15, 0.92)';
          ctx.strokeStyle = '#facc15'; ctx.lineWidth = 2.5;
          ctx.beginPath(); ctx.roundRect(40, 75, 460, 115, 18); ctx.fill(); ctx.stroke();

          ctx.font = '42px sans-serif';
          ctx.fillText(activeCue.icon || '💡', 62, 145);

          ctx.fillStyle = '#facc15'; ctx.font = 'bold 14px sans-serif';
          ctx.fillText((activeCue.statValue || 'POIN PENTING').toUpperCase(), 125, 115);

          ctx.fillStyle = '#ffffff'; ctx.font = 'bold 22px sans-serif';
          ctx.fillText((activeCue.brollTitle || '').substring(0, 26), 125, 150);
        }

        // C. TIPE TECH CALLOUT BOX (Tech / Software Demo)
        else if (activeCue.type === 'callout_box') {
          ctx.fillStyle = 'rgba(6, 78, 59, 0.92)';
          ctx.strokeStyle = '#34d399'; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.roundRect(50, 90, 440, 95, 14); ctx.fill(); ctx.stroke();

          ctx.fillStyle = '#a7f3d0'; ctx.font = 'bold 15px monospace';
          ctx.fillText(`> ${activeCue.icon || '⚡'} ${(activeCue.statValue || 'SYSTEM INFO').toUpperCase()}`, 72, 125);
          ctx.fillStyle = '#ffffff'; ctx.font = 'bold 21px sans-serif';
          ctx.fillText((activeCue.brollTitle || '').substring(0, 28), 72, 160);
        }

        // D. DYNAMIC CAPTION (Teks Ucapan di Bagian Bawah Layar)
        if (activeCue.caption) {
          const cap = activeCue.caption.toUpperCase();
          ctx.font = '900 27px sans-serif';
          const tw = ctx.measureText(cap).width;
          const bx = Math.max(20, (canvas.width - tw) / 2 - 22);

          ctx.fillStyle = selectedStyle === 'energy' ? '#f97316' : '#a3e635';
          ctx.beginPath(); ctx.roundRect(bx, 815, Math.min(canvas.width - 40, tw + 44), 56, 14); ctx.fill();

          ctx.fillStyle = '#080b08';
          ctx.fillText(cap, bx + 22, 852, canvas.width - 80);
        }
      }
    }

    function renderLoop() {
      drawCanvasFrame();
      requestAnimationFrame(renderLoop);
    }

    // 5. Export Video Hasil Akhir
    function exportFinalVideo() {
      const btn = document.getElementById('download-btn');
      btn.innerText = '⏳ Merender Video & Suara... Tunggu sampai selesai berputar';
      btn.disabled = true;

      video.pause();
      video.currentTime = 0;

      const canvasStream = canvas.captureStream(30);
      if (video.captureStream) {
        const vStream = video.captureStream();
        vStream.getAudioTracks().forEach(track => canvasStream.addTrack(track));
      }

      const recorder = new MediaRecorder(canvasStream, { mimeType: 'video/webm' });
      const chunks = [];
      recorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
      recorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'video/webm' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'video-automotion-ai.webm';
        a.click();
        btn.innerText = '↓ Unduh Video Hasil Render (.webm)';
        btn.disabled = false;
      };

      recorder.start();
      video.play();
      video.onended = () => {
        if (recorder.state === 'recording') recorder.stop();
      };
    }
  </script>
